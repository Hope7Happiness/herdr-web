#!/usr/bin/env bash
set -euo pipefail
script_path="$0"
while [ -L "$script_path" ]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  link_path="$(readlink "$script_path")"
  case "$link_path" in
    /*) script_path="$link_path" ;;
    *) script_path="$script_dir/$link_path" ;;
  esac
done
script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
exec node "$script_dir/herdr-remote.mjs" "$@"
